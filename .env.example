# =====================================================================================
#  ENVIRONMENT TEMPLATE
#
#  Copy this file to ".env" (which is gitignored) and adjust the values.
#  Docker Compose reads ".env" automatically from this folder, so nothing has to be
#  exported in the shell.
#
#      copy .env.example .env          Windows
#      cp .env.example .env            Linux / macOS
# =====================================================================================

# Host port where the API is published (left side of "8080:8080" in docker-compose.yml).
# Change it if port 8080 is already taken on the instance.
API_PORT=8080

# Host port where PostgreSQL is published.
# 5433 is used by default because a local PostgreSQL installation usually owns 5432.
POSTGRES_PORT=5433

# Browser origins allowed to call the API (CORS).
#   "*"                      any origin. Valid here because this API is public,
#                            stateless and does not use cookies.
#   "http://1.2.3.4:5500"    only the frontend served from that host and port.
# Multiple origins are separated by commas: "http://a:5500,http://b:5500"
APP_CORS_ALLOWED_ORIGINS=*
