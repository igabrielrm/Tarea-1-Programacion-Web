# ============================================================
#  .gitignore - Files that must NOT be pushed to the repository
# ============================================================

# Java compilation output
target/

# Operating system files (Windows / macOS)
.DS_Store
Thumbs.db

# IDEs
.idea/
*.iml
.vscode/
*.ipr
*.iws

# Logs
*.log
logs/

# Environment files (never commit real credentials)
.env

# ============================================================
#  NODE TOOLING (ESLint / Prettier)
#  The lockfile IS committed (reproducible installs); the downloaded packages are not.
# ============================================================
node_modules/

# ============================================================
#  PRIVATE STUDY GUIDE - personal notes, never pushed to GitHub
# ============================================================
guia_estudio_personal.md
